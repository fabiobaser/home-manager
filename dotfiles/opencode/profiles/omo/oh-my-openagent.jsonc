{
	"$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
	"model_fallback": true,
	"agent_order": ["sisyphus", "hephaestus", "prometheus", "atlas"],
	"agents": {
    "sisyphus": {
      "model": "zai-coding-plan/glm-5.2"
    },
    "oracle": {
      "model": "zai-coding-plan/glm-4.5-air"
    },
    "explore": {
      "model": "zai-coding-plan/glm-4.5-air"
    },
    "multimodal-looker": {
      "model": "zai-coding-plan/glm-5v-turbo"
    },
    "prometheus": {
      "model": "zai-coding-plan/glm-4.5-air"
    },
    "metis": {
      "model": "zai-coding-plan/glm-4.5-air"
    },
    "momus": {
      "model": "zai-coding-plan/glm-4.5-air"
    },
    "atlas": {
      "model": "zai-coding-plan/glm-4.5-air"
    },
    "sisyphus-junior": {
      "model": "zai-coding-plan/glm-4.5-air"
    }
	},
	"categories": {

    "visual-engineering": {
      "model": "zai-coding-plan/glm-5.2"
    },
    "ultrabrain": {
      "model": "zai-coding-plan/glm-5.2"
    },
    "deep": {
      "model": "zai-coding-plan/glm-5.2"
    },
    "artistry": {
      "model": "zai-coding-plan/glm-5-turbo"
    },
    "quick": {
      "model": "zai-coding-plan/glm-4.5-air"
    },
    "unspecified-low": {
      "model": "zai-coding-plan/glm-4.5-air"
    },
    "unspecified-high": {
      "model": "zai-coding-plan/glm-5.2"
    },
    "writing": {
      "model": "zai-coding-plan/glm-5-turbo"
    }
	},
	"background_task": {
		"providerConcurrency": {
			"opencode": 10
		},
		"modelConcurrency": {
			"opencode/deepseek-v4-flash-free": 10,
			"opencode/nemotron-3-super-free": 20,
			"opencode/big-pickle": 10
		}
	},
	"git_master": {
	},
	"experimental": {
		"aggressive_truncation": true
	},
	"tmux": {
		"enabled": false,
		"layout": "main-vertical",
		"main_pane_size": 60,
		"main_pane_min_width": 120,
		"agent_pane_min_width": 40,
		"isolation": "inline"
	}
}
